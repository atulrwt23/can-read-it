# Production settings for infra/prod/compose.yml. Fill in a copy and store it as the content of
# the Oracle Cloud Vault secret `canreadit-prod-env` (docs/deploy.md, step 4), or, with
# SECRETS_PROVIDER=file, as /opt/canreadit/.env (chmod 600). Never commit the filled-in copy.

# --- Images (built and published by GitHub Actions on every green push to main) ---
IMAGE_REGISTRY=ghcr.io/atulrwt23

# --- Tunnel: "quick" ($0, random trycloudflare.com URL) or "named" (needs a domain) ---
COMPOSE_PROFILES=quick
TUNNEL_TOKEN=

# --- Spring profiles: prod, plus demo to seed invented placeholder series (beta only) ---
SPRING_PROFILES_ACTIVE=prod,demo

# --- Cache refresh: the API asks the web app to refresh cached pages when a chapter goes live ---
# Optional (without it pages refresh within about a minute). Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Public address, for canonical URLs, social cards and the sitemap ---
# Optional: leave empty while on a quick tunnel (its address changes); set it with a domain,
# for example https://canreadit.example. Without it, those URLs are left out.
SITE_URL=

# --- Sign-in ---
# The key that signs access tokens: a base64 PKCS#8 P-256 private key, generated on your machine
# (docs/deploy.md, "Sign-in settings"). Optional: without it the API makes a new key on every start,
# so browsers silently renew their sign-in after each deploy.
AUTH_JWT_PRIVATE_KEY=
# Cloudflare Turnstile secret for the bot check on sign-up. Optional: without it the check is off.
TURNSTILE_SECRET_KEY=

# --- Email over SMTP (sign-in codes, password resets; docs/deploy.md, "Email settings") ---
# Optional: with SMTP_HOST empty, emails are logged and dropped, so only password sign-in works.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend, SMTP_PASSWORD=<API key>. MAIL_FROM's domain
# must be verified with the provider (SPF, DKIM), so this needs a domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# --- PostgreSQL (container on the VM) ---
POSTGRES_DB=canreadit
POSTGRES_USER=canreadit
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# --- Object storage: Cloudflare R2 bucket for images (public via its r2.dev URL for now) ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=canreadit-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# The bucket's public URL, e.g. https://pub-<id>.r2.dev (later: https://cdn.<your-domain>)
MEDIA_PUBLIC_BASE_URL=

# --- Backups: nightly pg_dump to a private R2 bucket (can reuse the endpoint above) ---
BACKUP_S3_ENDPOINT=
BACKUP_BUCKET=canreadit-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
