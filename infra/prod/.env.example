# Production environment for infra/prod/compose.yml. Lives at /opt/canreadit/.env on the VM
# (chmod 600, owned by root) and is never committed. Keep a copy in your password manager.

# --- Images (built and published by GitHub Actions on every green push to main) ---
IMAGE_REGISTRY=ghcr.io/atulrwt23

# --- Tunnel: "quick" ($0, random trycloudflare.com URL) or "named" (needs a domain) ---
COMPOSE_PROFILES=quick
TUNNEL_TOKEN=

# --- Spring profiles: prod, plus demo to seed invented placeholder series (beta only) ---
SPRING_PROFILES_ACTIVE=prod,demo

# --- PostgreSQL (container on the VM) ---
POSTGRES_DB=canreadit
POSTGRES_USER=canreadit
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# --- Object storage: Cloudflare R2 bucket for images (public via its r2.dev URL for now) ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=canreadit-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# The bucket's public URL, e.g. https://pub-<id>.r2.dev (later: https://cdn.<your-domain>)
MEDIA_PUBLIC_BASE_URL=

# --- Backups: nightly pg_dump to a private R2 bucket (can reuse the endpoint above) ---
BACKUP_S3_ENDPOINT=
BACKUP_BUCKET=canreadit-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
