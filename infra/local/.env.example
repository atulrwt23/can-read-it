# Local development environment. Copy to .env (git-ignored).
# The backend's `local` profile uses these same values as defaults, so
# `./gradlew bootRun` works without exporting anything.

# --- PostgreSQL ---
POSTGRES_DB=canreadit
POSTGRES_USER=canreadit
POSTGRES_PASSWORD=canreadit
# JDBC URL used by the backend
DB_URL=jdbc:postgresql://localhost:5432/canreadit

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Object storage (S3 API; SeaweedFS locally, Cloudflare R2 in the beta) ---
# Local keys must match infra/local/seaweedfs/s3.json.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=canreadit-media
S3_ACCESS_KEY=canreadit
S3_SECRET_KEY=canreadit-secret
# Base URL the browser uses to load public images (the CDN in prod).
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/canreadit-media

# --- Email (SMTP; Mailpit locally, Resend in the beta) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CanReadIt <no-reply@canreadit.local>

# --- Web (Next.js) ---
# Where server components reach the API. In the browser, /api/* is proxied same-origin.
API_INTERNAL_URL=http://localhost:8080
