{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!src/lib/api/schema.d.ts", "!.next", "!next-env.d.ts"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        // Images come from our CDN with known sizes and are served as-is (images.unoptimized),
        // so next/image would add nothing. Plain <img> with width/height avoids layout shift.
        "noImgElement": "off"
      }
    },
    "domains": { "next": "recommended", "react": "recommended" }
  },
  "overrides": [
    {
      // The prefers-reduced-motion reset must override every component's transitions.
      "includes": ["src/app/globals.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "tailwindDirectives": true } }
}
